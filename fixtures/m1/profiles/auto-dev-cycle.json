{
  "schema": "adc.project-profile/v1",
  "id": "prj_01m4tmb43hefctwv52nmq34fdj",
  "name": "auto-dev-cycle",
  "repo": {"url": "https://github.com/ekaynac/auto-dev-cycle.git", "base_ref": "refs/heads/main"},
  "forge": {
    "kind": "github",
    "capabilities": {"change_requests": false, "protected_branches": true, "required_checks": false},
    "settings": {}
  },
  "source_tests": {"dev_dependencies": true, "vcs_metadata": false},
  "package": {"recipe": [["go", "build", "-trimpath", "-o", "bin/", "./cmd/..."]], "outputs": ["bin"]},
  "runtime_verification": {"command": null, "facts_from": null},
  "toolchain": {
    "images": {"go": "ghcr.io/ekaynac/adc-prepared-go@sha256:1d2fa05bf24dc73dff179b0b08e6ee89cb82d8ac47b0c133cc578210fcce744b"},
    "dependency_recipe": {
      "lockfiles": ["go.mod", "go.sum"],
      "command": ["go", "mod", "download"],
      "registries": ["goproxy"]
    }
  },
  "gate": {
    "command": ["go", "test", "-count=1", "-json", "./..."],
    "result_adapter": "go_test_json",
    "baseline": {"kind": "measured", "relock_requires": "approval"},
    "environments": [
      {
        "name": "ci",
        "facts": {"vcs_metadata": false, "network": "none", "runtime": {"language_version": "go1.27.1", "os": "linux", "arch": "arm64"}},
        "owner": "operator"
      }
    ],
    "ownership_rules": "default"
  },
  "integration": {"plugin": "none", "topology": null, "receipts_required": []},
  "plugins": {"deploy": "none", "records": "json_ledger"},
  "protected_paths": [
    ".github/**",
    "Makefile",
    "adapters/contract/**",
    "docs/design/**",
    "docs/plan/**",
    "fixtures/m1/**",
    "gen/**",
    "go.mod",
    "go.sum",
    "go.work",
    "go.work.sum",
    "internal/adapterhost/**",
    "internal/attempt/**",
    "internal/authority/**",
    "internal/capacity/**",
    "internal/contract/**",
    "internal/eventstore/**",
    "internal/profile/**",
    "internal/receipt/**",
    "internal/results/**",
    "internal/sandbox/**",
    "internal/testguard/**",
    "schemas/**",
    "scripts/bootstrap-go.sh",
    "scripts/prepare-go-image.sh",
    "scripts/test-sandbox*",
    "spec/**",
    "vendor/**"
  ],
  "protected_documents": [],
  "data_policy": {"floor": "contracted", "routing": "verified", "allowed_destinations": []},
  "usage_profile_override": null,
  "priority": 100,
  "budget": {"rails": {"per_task_usd": "5", "per_day_usd": "20", "attempts_per_round": 3, "rounds_per_task": 5, "merge_operations_per_generation": 2}},
  "retention": {"attempt_continuity_post_closure_ttl": "P7D", "supervisor_notes_ttl": null, "blob_payload_ttl": null},
  "vocabulary": {"task_id_pattern": null, "branch_prefix": "adc/", "language": "en"}
}
