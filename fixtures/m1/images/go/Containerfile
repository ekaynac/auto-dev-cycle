#
# The prepared Go image of a project (P32, 00 §8 item 2; #226 entry 97): this
# repository's, or go-mini's. It is the pinned toolchain with the module cache
# for the project's lockfiles baked in, so the gate runs `go test -json`
# offline, and the builder's adapter (below). Build it only through
# scripts/prepare-go-image.sh PROJECT, which puts exactly the project's
# lockfiles (under lock/), warm.txt and each platform's adapter closure
# (under adapter/) into the build context and sets the dev.adc.prepared
# manifest label that the sandbox checks (sandbox.Image.CheckManifest and
# CheckAdapter).
#
# The base is go.mod's toolchain (go1.27.1), pinned by its multi-arch index
# digest (linux/amd64 and linux/arm64). It is fixed here, not a build
# argument: changing it is a reviewed change to this file.
FROM docker.io/library/golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66

# The sandbox runs with a read-only root, /tmp (256 MiB) and HOME on tmpfs,
# and no network: no module fetch, no other toolchain. A cold build of the
# dependencies does not fit in /tmp, so the build cache is warmed here and
# read-only at run time (go fails on a miss; the guard's loader then lists
# again with a cold cache in /tmp).
ENV GOTOOLCHAIN=local \
    GOFLAGS="-mod=readonly -buildvcs=false" \
    GOTELEMETRY=off \
    CGO_ENABLED=0 \
    GOCACHE=/opt/adc/gocache

WORKDIR /opt/adc/prepare
COPY lock/ warm.txt ./
# The only networked step: download and verify every module of the
# lockfiles (none for a project without dependencies). Then compile the standard library and the third-party packages
# the tests import (warm.txt, from go list at the base), for each gate
# platform (the integrity guard's go list types both; P14e-2c): a cache
# only, so a stale list costs time, never correctness.
RUN go mod download -x && go mod verify \
 && mkdir -p "$GOCACHE" \
 && for arch in amd64 arm64; do \
      export GOOS=linux GOARCH="$arch" GOAMD64=v1 GOARM64=v8.0 \
      && go build std && xargs -r go build < warm.txt || exit 1; \
    done \
 && rm -rf /root/.cache

# goindex=0: the module index would be written into the read-only cache.
# GOWORK=off: a go.work in the candidate would redirect dependencies around
# go.mod, go.sum and the module cache. -buildvcs=false (above): the image's
# git never runs on the workspace.
ENV GOPROXY=off \
    GOSUMDB=off \
    GOWORK=off \
    GODEBUG=goindex=0
WORKDIR /

# The builder's adapter (P22a-5d): make dist's lib/adc closure for the
# target platform (sandbox.AdapterClosure: the pinned Node, the http-chat
# adapter, the contract package, gen/ts and the production node_modules),
# which prepare-go-image.sh puts under adapter/linux-ARCH/ after checking it
# against the dist's SHA256SUMS. It runs as /opt/adc/lib/node/bin/node
# /opt/adc/lib/adapters/http-chat/src/main.ts. The label's adapter digest
# for the platform (sandbox.AdapterDigest) pins it: adcd refuses an image
# whose adapter is not its installed release's (Image.CheckAdapter). Owned
# by root, read-only at run time under the sandbox's --read-only root.
ARG TARGETARCH
COPY adapter/linux-${TARGETARCH}/ /opt/adc/lib/
