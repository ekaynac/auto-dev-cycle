{
  "repo": "repos/py-mini.git",
  "base": "5035cba02339490cb513b788410c84ad622fbef4",
  "image": "docker.io/library/python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70",
  "setup": [
    "python",
    "-m",
    "pip",
    "install",
    "--no-cache-dir",
    "--disable-pip-version-check",
    "--require-hashes",
    "--only-binary=:all:",
    "--target",
    "/workspace/.deps",
    "-r",
    "requirements-dev.txt"
  ],
  "test_command": [
    "env",
    "PYTHONPATH=/workspace/.deps",
    "PYTHONDONTWRITEBYTECODE=1",
    "python",
    "-m",
    "pytest",
    "-q",
    "--junitxml=junit.xml"
  ],
  "results": {
    "format": "junit_xml",
    "path": "junit.xml"
  },
  "acceptance": [
    {
      "path": "tests/test_hidden_format_grouping.py",
      "file": "../../t0/py-mini/tasks/py-mini-failing-then-green-1/hidden/tests/test_hidden_format_grouping.py"
    }
  ],
  "hidden_tests": [
    "pytest > tests.test_hidden_format_grouping > test_formatted_amounts_parse_back",
    "pytest > tests.test_hidden_format_grouping > test_grouping[-1000--EUR 1,000.00]",
    "pytest > tests.test_hidden_format_grouping > test_grouping[-9876543.215--EUR 9,876,543.22]",
    "pytest > tests.test_hidden_format_grouping > test_grouping[1000-EUR 1,000.00]",
    "pytest > tests.test_hidden_format_grouping > test_grouping[1000000000-EUR 1,000,000,000.00]",
    "pytest > tests.test_hidden_format_grouping > test_grouping[999.99-EUR 999.99]",
    "pytest > tests.test_hidden_format_grouping > test_rendered_invoice_groups_totals"
  ],
  "protected": [
    "**/conftest.py",
    "pytest.ini",
    "pyproject.toml",
    "setup.cfg",
    "tox.ini",
    "requirements-dev.txt",
    "tests/**",
    "**/sitecustomize.py",
    "**/usercustomize.py",
    ".deps/**"
  ],
  "timeout_seconds": 600
}
