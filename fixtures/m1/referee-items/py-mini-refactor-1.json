{
  "repo": "repos/py-mini.git",
  "base": "f64fc46fda78dedd8f8727feeb6d130caa7dbab8",
  "image": "docker.io/library/python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70",
  "setup": [
    "python",
    "-m",
    "pip",
    "install",
    "--no-cache-dir",
    "--disable-pip-version-check",
    "--require-hashes",
    "--only-binary=:all:",
    "--target",
    "/workspace/.deps",
    "-r",
    "requirements-dev.txt"
  ],
  "test_command": [
    "env",
    "PYTHONPATH=/workspace/.deps",
    "PYTHONDONTWRITEBYTECODE=1",
    "python",
    "-m",
    "pytest",
    "-q",
    "--junitxml=junit.xml"
  ],
  "results": {
    "format": "junit_xml",
    "path": "junit.xml"
  },
  "acceptance": [
    {
      "path": "tests/test_hidden_rounding_module.py",
      "file": "../../t0/py-mini/tasks/py-mini-refactor-1/hidden/tests/test_hidden_rounding_module.py"
    }
  ],
  "hidden_tests": [
    "pytest > tests.test_hidden_rounding_module > test_behaviour_is_unchanged",
    "pytest > tests.test_hidden_rounding_module > test_old_import_paths_still_work",
    "pytest > tests.test_hidden_rounding_module > test_round_money_lives_in_the_rounding_module"
  ],
  "protected": [
    "**/conftest.py",
    "pytest.ini",
    "pyproject.toml",
    "setup.cfg",
    "tox.ini",
    "requirements-dev.txt",
    "tests/**",
    "**/sitecustomize.py",
    "**/usercustomize.py",
    ".deps/**"
  ],
  "timeout_seconds": 600
}
