{
  "repo": "repos/go-mini.git",
  "base": "250c9a7ec3ed456e051c52c5da17120ae5d6a330",
  "image": "docker.io/library/golang:1.27.1-bookworm@sha256:8d48e12ec56735e9358640898b9d9b9fcca110612ed8a5567438c0a1baa24e66",
  "test_command": [
    "env",
    "GOCACHE=/tmp/gocache",
    "GOTOOLCHAIN=local",
    "GOFLAGS=-mod=mod",
    "GOPROXY=off",
    "go",
    "test",
    "-json",
    "./..."
  ],
  "results": {
    "format": "go_test_json",
    "path": "stdout"
  },
  "acceptance": [
    {
      "path": "sku/sku_hidden_test.go",
      "file": "../../t0/go-mini/tasks/go-mini-refactor-1/hidden/sku/sku_hidden_test.go"
    }
  ],
  "hidden_tests": [
    "example.com/gomini/sku > TestHiddenInventoryUsesSKUPackage",
    "example.com/gomini/sku > TestHiddenNormalize",
    "example.com/gomini/sku > TestHiddenNormalizeRejects"
  ],
  "protected": [
    "go.mod",
    "go.sum",
    "go.work",
    "go.work.sum",
    "vendor/**",
    "**/*_test.go",
    "**/testdata/**"
  ],
  "timeout_seconds": 600
}
