+// SPDX-License-Identifier: Apache-2.0
+
+// Package sku normalises and validates stock-keeping unit codes.
+package sku
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+)
+
+// MaxLength is the longest SKU accepted after normalisation.
+const MaxLength = 32
+
+// ErrInvalid is returned, wrapped, for an empty, too long or malformed SKU.
+var ErrInvalid = errors.New("inventory: invalid SKU")
+
+// Normalize trims surrounding whitespace and upper-cases raw, then accepts
+// 1..MaxLength characters of A-Z, 0-9 and '-'. On failure it returns "" and
+// an error wrapping ErrInvalid.
+func Normalize(raw string) (string, error) {
+	s := strings.ToUpper(strings.TrimSpace(raw))
+	if s == "" || len(s) > MaxLength || strings.IndexFunc(s, invalid) >= 0 {
+		return "", fmt.Errorf("%w: %q", ErrInvalid, raw)
+	}
+	return s, nil
+}
+
+func invalid(r rune) bool {
+	return !(r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '-')
+}
