 package inventory
 
-import "fmt"
+import (
+	"fmt"
+	"strconv"
+)
 
 // FormatCents renders an amount of cents as a decimal string with two
 // fraction digits, for example 1999 as "19.99" and -150 as "-1.50".
 func FormatCents(cents int) string {
+	if cents < 0 {
+		// Through uint64, so that the most negative int has an absolute value too.
+		u := uint64(-(cents + 1)) + 1
+		return "-" + strconv.FormatUint(u/100, 10) + fmt.Sprintf(".%02d", u%100)
+	}
 	return fmt.Sprintf("%d.%02d", cents/100, cents%100)
 }
