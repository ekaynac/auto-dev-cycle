+// SPDX-License-Identifier: Apache-2.0
+
+package inventory
+
+import "errors"
+
+// ErrSameStore is returned when a transfer names the same store as source and destination.
+var ErrSameStore = errors.New("inventory: transfer to the same store")
+
+// Transfer moves qty units of sku from s to dst, carrying the source unit
+// price over to the destination. On any error neither store changes.
+func (s *Store) Transfer(dst *Store, sku string, qty int) error {
+	if s == dst {
+		return ErrSameStore
+	}
+	key, err := normalizeSKU(sku)
+	if err != nil {
+		return err
+	}
+	if qty <= 0 {
+		return ErrInvalidQuantity
+	}
+	it, ok := s.items[key]
+	if !ok {
+		return ErrUnknownSKU
+	}
+	if qty > it.Qty {
+		return ErrInsufficientStock
+	}
+	if err := s.Remove(key, qty); err != nil {
+		return err
+	}
+	return dst.Add(key, qty, it.PriceCents)
+}
