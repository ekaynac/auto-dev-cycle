@@ -0,0 +1,33 @@
+<?php
+// SPDX-License-Identifier: Apache-2.0
+
+declare(strict_types=1);
+
+namespace PhpMini\Shop;
+
+use InvalidArgumentException;
+
+/**
+ * A whole-number percentage discount (0-100); the discount is rounded half up to the cent.
+ */
+final class PercentDiscount
+{
+    public function __construct(private readonly int $percent)
+    {
+        if ($percent < 0 || $percent > 100) {
+            throw new InvalidArgumentException("Discount must be between 0 and 100, got {$percent}");
+        }
+    }
+
+    public function percent(): int
+    {
+        return $this->percent;
+    }
+
+    public function applyTo(Money $amount): Money
+    {
+        $discount = intdiv($amount->cents() * $this->percent + 50, 100);
+
+        return $amount->subtract(Money::ofCents($discount, $amount->currency()));
+    }
+}
