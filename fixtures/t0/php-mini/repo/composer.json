{
    "name": "adc-fixtures/php-mini",
    "description": "A tiny money and cart library used as an auto-dev-cycle T0 fixture.",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "12.5.37"
    },
    "autoload": {
        "psr-4": {
            "PhpMini\\Shop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpMini\\Shop\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    }
}
