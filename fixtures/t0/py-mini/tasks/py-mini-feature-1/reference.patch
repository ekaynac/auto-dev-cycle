+def split_evenly(amount: Decimal, parts: int) -> list[Decimal]:
+    """Split an amount into `parts` cent-exact shares that sum to the rounded amount.
+
+    Shares differ by at most one cent; the larger shares (by magnitude) come first.
+    """
+    if parts < 1:
+        raise ValueError("parts must be at least 1")
+    cents = int(round_money(amount) / CENT)
+    sign = -1 if cents < 0 else 1
+    share, remainder = divmod(abs(cents), parts)
+    return [sign * (share + (1 if index < remainder else 0)) * CENT for index in range(parts)]
