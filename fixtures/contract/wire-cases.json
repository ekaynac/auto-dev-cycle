{
 "_comment": "The adapter wire corpus (docs/design/m0/09 \"Process model\"): each case is a byte stream read by the Go host (internal/adapterhost/wire) and the TypeScript reader (adapters/contract), each read whole and in small pieces. want lists each line's verdict in order: event, response, json (not strict JSON) or envelope (strict JSON, not an acceptable message); framing ends the stream, and nothing after it is read. decoded lists the value of each line the strict reader accepts, in order; for nest cases each side checks its strict value against its platform's ordinary JSON parser instead. Bytes: hex, else nest (prefix, open times times, inner, close times times, suffix, then a newline), else text as UTF-8; pad_to N pads text's first line with spaces after its opening brace to exactly N bytes, its newline not counted.",
 "cases": [
  {
   "name": "an event",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"adapter.event\",\"params\":{\"event\":\"heartbeat\"}}\n",
   "decoded": [
    {
     "jsonrpc": "2.0",
     "method": "adapter.event",
     "params": {
      "event": "heartbeat"
     }
    }
   ],
   "want": [
    "event"
   ]
  },
  {
   "name": "a result",
   "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}\n",
   "decoded": [
    {
     "jsonrpc": "2.0",
     "id": 1,
     "result": {}
    }
   ],
   "want": [
    "response"
   ]
  },
  {
   "name": "a null result",
   "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":null}\n",
   "decoded": [
    {
     "jsonrpc": "2.0",
     "id": 1,
     "result": null
    }
   ],
   "want": [
    "response"
   ]
  },
  {
   "name": "an error with data",
   "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32601,\"message\":\"no method\",\"data\":{\"x\":[1]}}}\n",
   "decoded": [
    {
     "jsonrpc": "2.0",
     "id": 1,
     "error": {
      "code": -32601,
      "message": "no method",
      "data": {
       "x": [
        1
       ]
      }
     }
    }
   ],
   "want": [
    "response"
   ]
  },
  {
   "name": "an event and a response, then end of input",
   "text": "{\"jsonrpc\":\"2.0\",\"method\":\"adapter.event\",\"params\":{\"event\":\"heartbeat\"}}\n{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{}}\n",
   "decoded": [
    {
     "jsonrpc": "2.0",
     "method": "adapter.event",
     "params": {
      "event": "heartbeat"
     }
    },
    {
     "jsonrpc": "2.0",
     "id": 1,
     "result": {}
    }
   ],
   "want": [
    "event",
    "response"
   ]
  },
  {
   "name": "empty input",
   "text": "",
   "want": []
  },
  {
   "name": "unknown members are allowed",
   "text": "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":1,\"extra\":true}\n",
   "decoded": [
    {
     "jsonrpc": "2.0",
     "id": 2,
     "result": 1,
     "extra": true
    }
   ],
   "want": [
    "response"
   ]
  },
  {
   "name": "an empty line",
   "text": "\n",
   "want": [
    "json"
   ]
  },
  {
   "name": "a top-level array",
   "text": "[]\n",
   "decoded": [
    []
   ],
   "want": [
    "envelope"
   ]
  },
  {
   "name": "jsonrpc 1.0",
   "text": "{\"jsonrpc\":\"1.0\",\"id\":1,\"result\":{}}\n",
   "decoded": [
    {
     "jsonrpc": "1.0",
     "id": 1,
     "result": {}
    }
   ],
   "want": [
    "envelope"
   ]
  },
  {
   "name": "no jsonrpc",
   "text": "{\"id\":1,\"result\":{}}\n",
   "decoded": [
    {
     "id": 1,
     "result": {}
    }
   ],
   "want": [
    "envelope"
   ]
  },
  {
   "name": "both result and error",
   "text": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{},\"error\":{\"code\":1,\"message\":\"x\"}}\n",
   "decoded": [
    {
     "jsonrpc": "2.0",
     "id": 1,
     "result": {},
     "error": {
      "code": 1,
      "message": "x"
     }
    }
   ],
   "want": [
    "envelope"
   ]
  },
