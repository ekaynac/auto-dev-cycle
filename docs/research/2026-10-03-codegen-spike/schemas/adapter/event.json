{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekaynac/auto-dev-cycle/schemas/adapter/event.json",
  "title": "AdapterEvent",
  "description": "Adapter → core notifications, normalised (docs/design/m0/09). Spike subset: four of the event kinds, discriminated by event.",
  "oneOf": [
    {"$ref": "#/$defs/TurnStart"},
    {"$ref": "#/$defs/Coverage"},
    {"$ref": "#/$defs/Upstream"},
    {"$ref": "#/$defs/Heartbeat"}
  ],
  "$defs": {
    "Envelope": {
      "type": "object",
      "required": ["attempt", "fencing_token", "call"],
      "properties": {
        "attempt": {"$ref": "../common/defs.json#/$defs/TypeID"},
        "fencing_token": {"type": "integer", "minimum": 1},
        "call": {"$ref": "../common/defs.json#/$defs/TypeID"}
      }
    },
    "TurnStart": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/Envelope"}],
      "required": ["event", "turn", "sub_call", "reported_at"],
      "unevaluatedProperties": false,
      "properties": {
        "event": {"const": "turn.start"},
        "turn": {"type": "integer", "minimum": 0},
        "sub_call": {"type": "string", "minLength": 1},
        "reported_at": {"type": "string"}
      }
    },
    "Coverage": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/Envelope"}],
      "required": ["event", "turn", "observable", "unobservable"],
      "unevaluatedProperties": false,
      "properties": {
        "event": {"const": "coverage"},
        "turn": {"type": "integer", "minimum": 0},
        "observable": {"enum": ["complete", "partial", "none"]},
        "unobservable": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["harness_instructions", "compaction", "harness_tool", "other"]}
        }
      }
    },
    "Upstream": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/Envelope"}],
      "required": ["event", "turn", "sub_call", "provider", "model_reported"],
      "unevaluatedProperties": false,
      "properties": {
        "event": {"const": "upstream"},
        "turn": {"type": "integer", "minimum": 0},
        "sub_call": {"type": "string", "minLength": 1},
        "provider": {"type": "string"},
        "model_reported": {"type": "string"}
      }
    },
    "Heartbeat": {
      "type": "object",
      "allOf": [{"$ref": "#/$defs/Envelope"}],
      "required": ["event"],
      "unevaluatedProperties": false,
      "properties": {
        "event": {"const": "heartbeat"}
      }
    }
  }
}
