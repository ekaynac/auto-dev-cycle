{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekaynac/auto-dev-cycle/schemas/records/receipt.json",
  "title": "Receipt",
  "description": "Evidence envelope (docs/design/m0/06), spike subset: subjects tree, proposal and call (object_revision and environment omitted). outcome, reason, verdict and conclusions_digest are derived by internal/receipt, never accepted from the producer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "instrument", "subject", "provenance", "produced_at", "valid_until", "predicates", "outcome", "reason", "detail", "verdict", "conclusions_digest", "supersedes"],
  "properties": {
    "id": {"$ref": "../common/defs.json#/$defs/TypeID"},
    "kind": {"enum": ["gate", "integration", "deploy", "review", "phase_gate", "probe", "dependency_prep", "custom"]},
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "../common/defs.json#/$defs/Digest"}
      }
    },
    "subject": {"$ref": "#/$defs/Subject"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "attempt", "calls", "model_families", "contributors"],
      "properties": {
        "command": {"type": "string"},
        "attempt": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/TypeID"}]},
        "calls": {"type": "array", "items": {"$ref": "../common/defs.json#/$defs/TypeID"}},
        "model_families": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "contributors": {"type": "array", "items": {"$ref": "../common/defs.json#/$defs/TypeID"}}
      }
    },
    "produced_at": {"$ref": "../common/defs.json#/$defs/Time"},
    "valid_until": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/Time"}]},
    "predicates": {"type": "array", "items": {"$ref": "#/$defs/Predicate"}},
    "outcome": {"$ref": "../common/defs.json#/$defs/Outcome"},
    "reason": {"$ref": "../common/defs.json#/$defs/ReasonCode"},
    "detail": {"type": "string"},
    "verdict": {"oneOf": [{"type": "null"}, {"enum": ["go", "no_go"]}]},
    "conclusions_digest": {"$ref": "../common/defs.json#/$defs/Digest"},
    "supersedes": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/TypeID"}]}
  },
  "$defs": {
    "Predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "outcome", "reason", "evidence"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "outcome": {"$ref": "../common/defs.json#/$defs/Outcome"},
        "reason": {"$ref": "../common/defs.json#/$defs/ReasonCode"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blob", "media_type"],
            "properties": {
              "blob": {"$ref": "../common/defs.json#/$defs/Digest"},
              "media_type": {"type": "string", "minLength": 1}
            }
          }
        },
        "payload": {
          "description": "Typed predicate facts; validated against the instrument contract's payload_schema (06 rule 7), selected at run time by instrument digest.",
          "type": "object",
          "x-adc-open-payload": "instrument.payload_schema"
        }
      }
    },
    "Demand": {
      "description": "Controller-bound evidence demand (12) and the run that produced the receipt [PR5-2].",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "run"],
          "properties": {
            "key": {"$ref": "../common/defs.json#/$defs/Digest"},
            "run": {"$ref": "../common/defs.json#/$defs/TypeID"}
          }
        }
      ]
    },
    "Subject": {
      "description": "Typed subject, discriminated by type (06 [M8]); each variant carries the demand.",
      "oneOf": [
        {"$ref": "#/$defs/TreeSubject"},
        {"$ref": "#/$defs/ProposalSubject"},
        {"$ref": "#/$defs/CallSubject"}
      ]
    },
    "TreeSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "project", "tree", "head", "environment", "contract_revision", "demand"],
      "properties": {
        "type": {"const": "tree"},
        "project": {"$ref": "../common/defs.json#/$defs/TypeID"},
        "tree": {"$ref": "../common/defs.json#/$defs/GitID"},
        "head": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/GitID"}]},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "description"],
          "properties": {
            "identity": {"$ref": "../common/defs.json#/$defs/Digest"},
            "description": {"type": "string"}
          }
        },
        "contract_revision": {"type": "string", "minLength": 1},
        "demand": {"$ref": "#/$defs/Demand"}
      }
    },
    "ProposalSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "proposal", "binding_digest", "demand"],
      "properties": {
        "type": {"const": "proposal"},
        "proposal": {"$ref": "../common/defs.json#/$defs/TypeID"},
        "binding_digest": {"$ref": "../common/defs.json#/$defs/Digest"},
        "demand": {"$ref": "#/$defs/Demand"}
      }
    },
    "CallSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "call", "demand"],
      "properties": {
        "type": {"const": "call"},
        "call": {"$ref": "../common/defs.json#/$defs/TypeID"},
        "demand": {"$ref": "#/$defs/Demand"}
      }
    }
  }
}
