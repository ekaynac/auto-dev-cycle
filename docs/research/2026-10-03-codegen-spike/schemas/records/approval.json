{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekaynac/auto-dev-cycle/schemas/records/approval.json",
  "title": "Approval",
  "description": "Approval record (docs/design/m0/04). change_class is computed by authority, never supplied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "actor", "actor_kind", "action", "change_class", "project", "object", "expected_state", "scope", "confirmation", "answers", "supersedes", "reason", "at"],
  "properties": {
    "id": {"$ref": "../common/defs.json#/$defs/TypeID"},
    "actor": {"$ref": "../common/defs.json#/$defs/TypeID"},
    "actor_kind": {"enum": ["operator", "supervisor", "system"]},
    "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "change_class": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"}
    },
    "project": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/TypeID"}]},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version", "digest"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "../common/defs.json#/$defs/Digest"}
      }
    },
    "expected_state": {
      "description": "Exactly one of version or digest.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {"version": {"type": "integer", "minimum": 0}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest"],
          "properties": {"digest": {"$ref": "../common/defs.json#/$defs/Digest"}}
        }
      ]
    },
    "scope": {"type": "object", "description": "Schema per action (validated by the action registry)."},
    "grant": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/TypeID"}]},
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "challenge", "satisfied_by"],
      "properties": {
        "policy": {"enum": ["none", "independent_review", "human"]},
        "challenge": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/TypeID"}]},
        "satisfied_by": {"type": "array", "items": {"$ref": "../common/defs.json#/$defs/TypeID"}}
      }
    },
    "answers": {"type": "array", "items": {"$ref": "../common/defs.json#/$defs/TypeID"}},
    "supersedes": {"type": "array", "items": {"$ref": "../common/defs.json#/$defs/TypeID"}},
    "question": {"oneOf": [{"type": "null"}, {"type": "string"}]},
    "answer_verbatim": {"oneOf": [{"type": "null"}, {"type": "string"}]},
    "reason": {"type": "string", "minLength": 1},
    "at": {"$ref": "../common/defs.json#/$defs/Time"}
  }
}
