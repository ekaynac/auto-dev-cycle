{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekaynac/auto-dev-cycle/schemas/records/approval.json",
  "title": "Approval",
  "description": "Approval record (docs/design/m0/04). change_class is computed by authority, never supplied. scope is validated per action: the allOf below selects the action's scope schema (spike: two actions).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "actor", "actor_kind", "action", "change_class", "project", "object", "expected_state", "scope", "grant", "confirmation", "answers", "supersedes", "question", "answer_verbatim", "reason", "at"],
  "properties": {
    "id": {"$ref": "../common/defs.json#/$defs/TypeID"},
    "actor": {"$ref": "../common/defs.json#/$defs/TypeID"},
    "actor_kind": {"enum": ["operator", "supervisor", "system"]},
    "action": {"enum": ["plan.approve", "input.answer"]},
    "change_class": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"}
    },
    "project": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/TypeID"}]},
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "version", "digest"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "digest": {"$ref": "../common/defs.json#/$defs/Digest"}
      }
    },
    "expected_state": {
      "description": "Keyed union: exactly one of version or digest.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {"version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest"],
          "properties": {"digest": {"$ref": "../common/defs.json#/$defs/Digest"}}
        }
      ]
    },
    "scope": {"type": "object", "x-adc-open-payload": "action.scope"},
    "grant": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/TypeID"}]},
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "challenge", "satisfied_by"],
      "properties": {
        "policy": {"enum": ["none", "independent_review", "human"]},
        "challenge": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/TypeID"}]},
        "satisfied_by": {"type": "array", "items": {"$ref": "../common/defs.json#/$defs/TypeID"}}
      }
    },
    "answers": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/defs.json#/$defs/TypeID"}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/defs.json#/$defs/TypeID"}},
    "question": {"oneOf": [{"type": "null"}, {"type": "string"}]},
    "answer_verbatim": {"oneOf": [{"type": "null"}, {"type": "string"}]},
    "reason": {"type": "string", "minLength": 1},
    "at": {"$ref": "../common/defs.json#/$defs/Time"}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "plan.approve"}}, "required": ["action"]},
      "then": {"properties": {"scope": {"$ref": "#/$defs/PlanApproveScope"}}}
    },
    {
      "if": {"properties": {"action": {"const": "input.answer"}}, "required": ["action"]},
      "then": {"properties": {"scope": {"$ref": "#/$defs/InputAnswerScope"}}}
    }
  ],
  "$defs": {
    "PlanApproveScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_revision"],
      "properties": {"plan_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}
    },
    "InputAnswerScope": {
      "description": "04 'Owed inputs': answers is derived from this scope.",
      "type": "object",
      "additionalProperties": false,
      "required": ["owed_input", "owed_revision", "answer"],
      "properties": {
        "owed_input": {"$ref": "../common/defs.json#/$defs/TypeID"},
        "owed_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "answer": {"type": "object", "x-adc-open-payload": "owed_input.answer"}
      }
    }
  }
}
