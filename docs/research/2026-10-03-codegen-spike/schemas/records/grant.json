{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekaynac/auto-dev-cycle/schemas/records/grant.json",
  "title": "Grant",
  "description": "Grant (docs/design/m0/04). Added to the spike for the array-or-literal union (projects) and typed maps (confirmation_overrides).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "actor", "projects", "actions", "reads", "valid_from", "expires_at", "confirmation_overrides", "issued_by", "approval"],
  "properties": {
    "id": {"$ref": "../common/defs.json#/$defs/TypeID"},
    "actor": {"$ref": "../common/defs.json#/$defs/TypeID"},
    "projects": {"$ref": "#/$defs/ProjectSet"},
    "actions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ActionKind"}},
    "reads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "kinds"],
      "properties": {
        "projects": {"oneOf": [{"const": "same"}, {"type": "array", "uniqueItems": true, "items": {"$ref": "../common/defs.json#/$defs/TypeID"}}]},
        "kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "valid_from": {"$ref": "../common/defs.json#/$defs/Time"},
    "expires_at": {"$ref": "../common/defs.json#/$defs/Time"},
    "confirmation_overrides": {
      "description": "May only tighten (checked by authority, not by the schema).",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/ActionKind"},
      "additionalProperties": {"enum": ["independent_review", "human"]}
    },
    "issued_by": {"$ref": "../common/defs.json#/$defs/TypeID"},
    "approval": {"$ref": "../common/defs.json#/$defs/TypeID"}
  },
  "$defs": {
    "ActionKind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"},
    "ProjectSet": {
      "description": "Array-or-literal union: a list of projects, or \"*\" for all.",
      "oneOf": [
        {"const": "*"},
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "../common/defs.json#/$defs/TypeID"}}
      ]
    }
  }
}
