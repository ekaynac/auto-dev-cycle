{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekaynac/auto-dev-cycle/schemas/vocab/registry.json",
  "title": "VocabRegistry",
  "description": "One vocabulary registry file (schemas/vocab/*.yaml, docs/design/m0/02), discriminated by its schema field. Cross-file rules (a reason's hold exists, codes are unique) are checked by internal/vocab.",
  "oneOf": [
    {"$ref": "#/$defs/OutcomesFile"},
    {"$ref": "#/$defs/ReasonsFile"},
    {"$ref": "#/$defs/HoldsFile"},
    {"$ref": "#/$defs/ActionsFile"}
  ],
  "$defs": {
    "Code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "Owner": {"enum": ["system", "operator", "grant_holder", "confirmation_policy", "named_owner", "environment_owner"]},
    "Semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "OutcomesFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "outcomes"],
      "properties": {
        "schema": {"const": "adc.vocab.outcomes/v1"},
        "outcomes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome", "description"],
            "properties": {
              "outcome": {"enum": ["found", "empty", "could_not_run", "failed"]},
              "description": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "ReasonsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "reasons"],
      "properties": {
        "schema": {"const": "adc.vocab.reasons/v1"},
        "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Reason"}}
      }
    },
    "Reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "outcomes", "domain", "description", "introduced", "deprecated", "source"],
      "properties": {
        "code": {"$ref": "#/$defs/Code"},
        "outcomes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["found", "empty", "could_not_run", "failed"]}},
        "domain": {"enum": ["capacity", "cycle", "gate", "review", "authority", "knowledge", "forge", "sandbox", "adapter", "ops"]},
        "description": {"type": "string", "minLength": 1},
        "hold": {"$ref": "#/$defs/Code"},
        "introduced": {"$ref": "#/$defs/Semver"},
        "deprecated": {"description": "The version that deprecated the code; null while current.", "oneOf": [{"type": "null"}, {"$ref": "#/$defs/Semver"}]},
        "source": {"description": "Where the code was introduced: a design note number, or legacy:<golden>.", "type": "string", "pattern": "^([0-9]{2}|legacy:[a-z0-9-]+)$"}
      }
    },
    "HoldsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "holds"],
      "properties": {
        "schema": {"const": "adc.vocab.holds/v1"},
        "holds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Hold"}}
      }
    },
    "ActionsFile": {
      "description": "The action registry (docs/design/m0/04 \"Action registry\"): every mutating action kind, one command endpoint each (08), and the supervisor confirmation default of every sensitive change class. An action whose effective change is in no class needs no confirmation (none). Authority computes the class from the effective change and never trusts the action's name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "actions", "change_classes"],
      "properties": {
        "schema": {"const": "adc.vocab.actions/v1"},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Action"}},
        "change_classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ChangeClassDefault"}}
      }
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "family", "description", "introduced", "deprecated", "source"],
      "properties": {
        "action": {"$ref": "../records/grant.json#/$defs/ActionKind"},
        "family": {"description": "The CLI noun that carries it (08 \"CLI rules\"); the parity test maps each action to a CLI command and a dashboard control.", "enum": ["project", "task", "holds", "approve", "propose", "grant", "seat", "packet", "digest", "notes", "sources", "admin"]},
        "description": {"type": "string", "minLength": 1},
        "introduced": {"$ref": "#/$defs/Semver"},
        "deprecated": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Semver"}]},
        "source": {"type": "string", "pattern": "^[0-9]{2}$"}
      }
    },
    "ChangeClassDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "confirmation", "settable_to_human", "every_actor_kind", "description", "source"],
      "properties": {
        "class": {"$ref": "../records/approval.json#/$defs/ChangeClass"},
        "confirmation": {"description": "The supervisor default (D32).", "enum": ["independent_review", "human"]},
        "settable_to_human": {"description": "Whether a grant may tighten it to human (a human default is already the tightest).", "type": "boolean"},
        "every_actor_kind": {"description": "True only where an operator token also needs a presence-verified confirmation (KA1: framework prose export).", "type": "boolean"},
        "description": {"type": "string", "minLength": 1},
        "source": {"description": "The decision or review item that set it.", "type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"confirmation": {"const": "human"}}}, "then": {"properties": {"settable_to_human": {"const": false}}}},
        {"if": {"properties": {"every_actor_kind": {"const": true}}}, "then": {"properties": {"confirmation": {"const": "human"}}}}
      ]
    },
    "Hold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hold", "signal", "signal_detail", "owner", "page_after", "escalate_to"],
      "properties": {
        "hold": {"$ref": "#/$defs/Code"},
        "signal": {"enum": ["time", "receipt", "revision", "approval", "human_act", "probe", "config_change"]},
        "signal_detail": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/Owner"},
        "page_after": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/Duration"}]},
        "escalate_to": {"description": "Who owns the hold once page_after passes without the signal; null keeps the owner.", "oneOf": [{"type": "null"}, {"$ref": "#/$defs/Owner"}]}
      }
    }
  }
}
