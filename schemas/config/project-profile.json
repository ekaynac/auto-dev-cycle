{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekaynac/auto-dev-cycle/schemas/config/project-profile.json",
  "title": "ProjectProfile",
  "description": "Everything project-shaped (docs/design/m0/07). Core code reads nothing project-specific from anywhere else. Every field is required; null is explicit. Cross-field rules (environment references, path forms, glob syntax, forge capabilities, budget order) belong to internal/profile.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "repo", "forge", "source_tests", "package", "runtime_verification", "toolchain", "gate", "integration", "plugins", "protected_paths", "protected_documents", "data_policy", "usage_profile_override", "priority", "budget", "retention", "vocabulary"],
  "properties": {
    "schema": {"const": "adc.project-profile/v1"},
    "id": {"$ref": "../common/defs.json#/$defs/ProjectID"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "base_ref"],
      "properties": {
        "url": {"description": "Any git URL.", "type": "string", "minLength": 1},
        "base_ref": {
          "description": "The branch work lands on; parameterised, never assumed (A15). Full git ref syntax is checked by internal/profile.",
          "type": "string",
          "pattern": "^refs/heads/[^\\t\\n\\f\\r ]+$"
        }
      }
    },
    "forge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capabilities", "settings"],
      "properties": {
        "kind": {"enum": ["git", "github", "gitlab"]},
        "capabilities": {
          "description": "Declared, because plain git has none of them.",
          "type": "object",
          "additionalProperties": false,
          "required": ["change_requests", "protected_branches", "required_checks"],
          "properties": {
            "change_requests": {"type": "boolean"},
            "protected_branches": {"type": "boolean"},
            "required_checks": {"type": "boolean"}
          }
        },
        "settings": {
          "description": "Per forge kind. Reserved in v1: no settings are defined yet, so the object is empty.",
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        }
      }
    },
    "source_tests": {
      "description": "The gate's workspace (13 \"Source tests, package, runtime verification\").",
      "type": "object",
      "additionalProperties": false,
      "required": ["dev_dependencies", "vcs_metadata"],
      "properties": {
        "dev_dependencies": {"type": "boolean"},
        "vcs_metadata": {"description": "True only if the test suite needs it (a declared build-time fact).", "type": "boolean"}
      }
    },
    "package": {
      "description": "The deployable artifact; its bytes are hashed and exactly those bytes are deployed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "outputs"],
      "properties": {
        "recipe": {"description": "Commands run in order.", "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Argv"}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/RepoPath"}}
      }
    },
    "runtime_verification": {
      "description": "Runtime-facing checks against the package artifact, with the runtime facts of a gate environment.",
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "facts_from"],
      "properties": {
        "command": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Argv"}]},
        "facts_from": {
          "description": "The gate environment whose runtime facts apply; null exactly when there is no command.",
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/EnvironmentName"}]
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "dependency_recipe"],
      "properties": {
        "images": {
          "description": "Images pinned by digest; at least one, since dependency preparation, build and gate run in containers.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/Slug"},
          "additionalProperties": {"$ref": "#/$defs/PinnedImage"}
        },
        "dependency_recipe": {
          "description": "Phase 1 of the sandbox: the only phase with network, limited to the registries named.",
          "type": "object",
          "additionalProperties": false,
          "required": ["lockfiles", "command", "registries"],
          "properties": {
            "lockfiles": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/RepoPath"}},
            "command": {"$ref": "#/$defs/Argv"},
            "registries": {
              "type": "array",
              "uniqueItems": true,
              "items": {"enum": ["npm", "pypi", "packagist", "goproxy", "crates", "rubygems", "maven"]}
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result_adapter", "baseline", "environments", "ownership_rules"],
      "properties": {
        "command": {"description": "Run in phase 2, without network.", "$ref": "#/$defs/Argv"},
        "result_adapter": {
          "description": "How gate output becomes per-test results; custom:<plugin> names a result plugin.",
          "type": "string",
          "pattern": "^(junit_xml|tap|go_test_json|none|custom:[a-z0-9][a-z0-9._-]*)$"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "relock_requires"],
          "properties": {
            "kind": {"const": "measured"},
            "relock_requires": {"const": "approval"}
          }
        },
        "environments": {
          "description": "Target environments whose gate must hold before merge.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "facts", "owner"],
            "properties": {
              "name": {"$ref": "#/$defs/EnvironmentName"},
              "facts": {
                "description": "Published to the builder brief and the reviewer.",
                "type": "object",
                "additionalProperties": false,
                "required": ["vcs_metadata", "network", "runtime"],
                "properties": {
                  "vcs_metadata": {"type": "boolean"},
                  "network": {"enum": ["none", "loopback", "full"]},
                  "runtime": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["language_version", "os", "arch"],
                    "properties": {
                      "language_version": {"type": "string", "minLength": 1},
                      "os": {"type": "string", "minLength": 1},
                      "arch": {"type": "string", "minLength": 1}
                    }
                  }
                }
              },
              "owner": {"description": "Who fixes environment faults (wrong_owner holds).", "type": "string", "minLength": 1}
            }
          }
        },
        "ownership_rules": {"description": "Gate-output classification (07); only the default rules exist in v1.", "const": "default"}
      }
    },
    "integration": {
      "description": "Phase 3; the topology is controller-owned (A2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "topology", "receipts_required"],
      "properties": {
        "plugin": {"enum": ["none", "docker-compose"]},
        "topology": {
          "description": "Pinned; changed only by integration.change_topology (04). Null exactly when the plugin is none.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["files", "adopted_revision", "digest"],
              "properties": {
                "files": {"description": "Protected.", "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/RepoPath"}},
                "adopted_revision": {"$ref": "../common/defs.json#/$defs/GitID"},
                "digest": {"description": "Of the adopted topology content.", "$ref": "../common/defs.json#/$defs/Digest"}
              }
            }
          ]
        },
        "receipts_required": {"type": "array", "uniqueItems": true, "items": {"$ref": "../records/receipt.json#/$defs/Name"}}
      },
      "if": {"properties": {"plugin": {"const": "none"}}},
      "then": {"properties": {"topology": {"const": null}}},
      "else": {"properties": {"topology": {"not": {"const": null}}}}
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploy", "records"],
      "properties": {
        "deploy": {"enum": ["none", "script", "docker-compose"]},
        "records": {"description": "The delivery record format.", "enum": ["none", "markdown_table", "json_ledger"]}
      }
    },
    "protected_paths": {
      "description": "Canon, topology and knowledge documents; changed only through the protected-document operation.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/Glob"}
    },
    "protected_documents": {
      "description": "The protected paths that hold decisions and conventions; each is covered by protected_paths.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/Glob"}
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["floor", "routing", "allowed_destinations"],
      "properties": {
        "floor": {"enum": ["own", "contracted", "free_unknown"]},
        "routing": {"enum": ["verified", "reported_ok"]},
        "allowed_destinations": {
          "description": "Destinations of the source registry; empty means derived from the usage profile.",
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/Slug"}
        }
      }
    },
    "usage_profile_override": {
      "description": "May only narrow the installation's usage profile without approval.",
      "oneOf": [{"type": "null"}, {"enum": ["standard", "open", "on-prem"]}]
    },
    "priority": {"description": "Higher runs first.", "type": "integer", "minimum": 0, "maximum": 1000},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rails"],
      "properties": {
        "rails": {
          "description": "Rails, not budgets: spending stops at them.",
          "type": "object",
          "additionalProperties": false,
          "required": ["per_task_usd", "per_day_usd"],
          "properties": {
            "per_task_usd": {"$ref": "#/$defs/USD"},
            "per_day_usd": {"$ref": "#/$defs/USD"}
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_continuity_post_closure_ttl", "supervisor_notes_ttl", "blob_payload_ttl"],
      "properties": {
        "attempt_continuity_post_closure_ttl": {
          "description": "Starts when the task closes; pinned (resumable) records are never purged.",
          "$ref": "../common/defs.json#/$defs/Duration"
        },
        "supervisor_notes_ttl": {"oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/Duration"}]},
        "blob_payload_ttl": {
          "description": "A payload purge leaves tombstones; accounting and history are never purged.",
          "oneOf": [{"type": "null"}, {"$ref": "../common/defs.json#/$defs/Duration"}]
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id_pattern", "branch_prefix", "language"],
      "properties": {
        "task_id_pattern": {
          "description": "An RE2 regular expression for product task ids (e.g. a ledger grammar); null means framework ids.",
          "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
        },
        "branch_prefix": {
          "description": "E.g. adc/ or team/adc/. Full git ref syntax is checked by internal/profile.",
          "type": "string",
          "pattern": "^[^\\t\\n\\f\\r ]+/$"
        },
        "language": {"description": "Product language(s); framework vocabulary stays English.", "type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "Argv": {
      "description": "A command as argv, run without a shell. Arguments may be empty (some commands need an empty argument); internal/profile requires a non-empty executable and refuses NUL bytes.",
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "RepoPath": {
      "description": "A path inside the repository: relative, slash-separated, clean (internal/profile checks the form).",
      "type": "string",
      "minLength": 1
    },
    "Glob": {
      "description": "A repository path pattern: slash-separated segments, each '**' or a path.Match pattern (internal/profile compiles it).",
      "type": "string",
      "minLength": 1
    },
    "Slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "EnvironmentName": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "PinnedImage": {
      "description": "An image reference pinned by digest.",
      "type": "string",
      "pattern": "^[^@\\t\\n\\f\\r ]+@sha256:[0-9a-f]{64}$"
    },
    "USD": {
      "description": "An amount in US dollars as a decimal string (no floating point), at most two decimals.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,2})?$"
    }
  }
}
