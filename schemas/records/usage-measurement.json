{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ekaynac/auto-dev-cycle/schemas/records/usage-measurement.json",
  "title": "UsageMeasurement",
  "description": "One usage report for one call (docs/design/m0/05 \"Usage and settlement\" [M7]). Outputs are fenced; accounting is not: reports are accepted from any attempt, stale or not. internal/capacity/ledger reconciles them: deltas deduplicated by (call, sequence), a final replaces their sum only when not lower, and only a provider_reconciliation can lower a figure.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "call", "attempt", "lease", "kind", "sequence", "tokens", "turns", "milliseconds", "cost", "source_of_truth"],
  "properties": {
    "id": {"$ref": "../common/defs.json#/$defs/MeasurementID"},
    "call": {"description": "The call-ledger id, recorded in the call's intent (03 effects).", "$ref": "../common/defs.json#/$defs/CallID"},
    "attempt": {"$ref": "../common/defs.json#/$defs/AttemptID"},
    "lease": {"$ref": "../common/defs.json#/$defs/LeaseID"},
    "kind": {"enum": ["delta", "final", "provider_reconciliation"]},
    "sequence": {"description": "Per call: deltas are numbered from 0; a final or reconciliation also carries one, so a later report of the same kind supersedes an earlier.", "type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in", "out", "cache_read", "cache_write"],
      "properties": {
        "in": {"$ref": "resource-group.json#/$defs/Amount"},
        "out": {"$ref": "resource-group.json#/$defs/Amount"},
        "cache_read": {"$ref": "resource-group.json#/$defs/Amount"},
        "cache_write": {"$ref": "resource-group.json#/$defs/Amount"}
      }
    },
    "turns": {"$ref": "resource-group.json#/$defs/Amount"},
    "milliseconds": {"$ref": "resource-group.json#/$defs/Amount"},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount_micros", "currency", "basis", "estimate"],
      "properties": {
        "amount_micros": {"description": "Millionths of the currency unit.", "$ref": "resource-group.json#/$defs/Amount"},
        "currency": {"description": "ISO 4217.", "type": "string", "pattern": "^[A-Z]{3}$"},
        "basis": {"enum": ["cash", "subscription_equivalent", "free", "local"]},
        "estimate": {"type": "boolean"}
      }
    },
    "source_of_truth": {"enum": ["provider_usage", "adapter_report", "gateway_count", "none"]}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "provider_reconciliation"}}}, "then": {"properties": {"source_of_truth": {"const": "provider_usage"}}}}
  ]
}
